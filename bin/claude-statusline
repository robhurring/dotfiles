#!/usr/bin/env bash
# Claude Code status line (requires Nerd Font + true color terminal)
#
# Mode is selected per-machine via ~/.claude/settings.json (not synced):
#   claude-statusline --plan   # subscription: context + 5h session bar + 7d window
#   claude-statusline --api    # API account: context only (no rate-limit windows)
#
# Both modes share: vim badge, dir/branch, model, and context count/max/%.

MODE="plan"
case "$1" in
  --api)  MODE="api" ;;
  --plan) MODE="plan" ;;
esac

input=$(cat)

CWD=$(echo "$input" | jq -r '.workspace.current_dir // .cwd // ""')
BRANCH=$(git -C "$CWD" symbolic-ref --short HEAD 2>/dev/null || echo "detached")
WORKTREE=$(echo "$input" | jq -r '.worktree.name // empty')

if [ -n "$WORKTREE" ]; then
  DIR="${WORKTREE}:${BRANCH}"
else
  DIR=" ${BRANCH}"
fi

MODEL=$(echo "$input" | jq -r '.model.display_name // ""')

PCT=$(echo "$input" | jq -r '.context_window.used_percentage // empty')
USED_TOKENS=$(echo "$input" | jq -r '.context_window.total_input_tokens // empty')
MAX_TOKENS=$(echo "$input" | jq -r '.context_window.context_window_size // empty')

FIVE_H=$(echo "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty')
SEVEN_D=$(echo "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')

VIM_MODE=$(echo "$input" | jq -r '.vim.mode // empty')

# True color helpers: \033[38;2;R;G;Bm (fg)  \033[48;2;R;G;Bm (bg)
R="\033[0m"
BOLD="\033[1m"
SEP="\033[38;2;75;75;95m│${R}"

# Palette — muted, low-contrast
TEAL="\033[38;2;130;125;155m"      # usage ok — muted purple-gray
AMBER="\033[38;2;170;150;100m"     # usage warn — dusty gold
CORAL="\033[38;2;170;100;100m"     # usage danger — muted rose
LAVENDER="\033[38;2;100;100;115m"  # model name (dim)
SLATE="\033[38;2;65;68;80m"        # dim text / labels
SKY="\033[38;2;85;90;100m"         # directory (gray)

# Vim badge backgrounds
VIM_INSERT_BG="\033[48;2;50;50;60m"    # muted gray
VIM_NORMAL_BG="\033[48;2;40;55;80m"    # muted blue
VIM_VISUAL_BG="\033[48;2;70;45;70m"    # muted plum

# Pick a usage color (teal/amber/coral) for an integer percentage.
usage_color() {
  local v="$1"
  if   [ "$v" -lt 50 ]; then printf "%b" "$TEAL"
  elif [ "$v" -lt 75 ]; then printf "%b" "$AMBER"
  else                       printf "%b" "$CORAL"
  fi
}

# Format a token count: 850 -> 850, 150000 -> 150k, 1200000 -> 1.2M.
fmt_tokens() {
  local n="$1"
  [ -z "$n" ] && { printf -- "--"; return; }
  if   [ "$n" -ge 1000000 ]; then awk -v n="$n" 'BEGIN{printf "%.1fM", n/1000000}'
  elif [ "$n" -ge 1000 ];    then printf "%dk" "$((n / 1000))"
  else                            printf "%d" "$n"
  fi
}

# Render a 10-cell bar (▓ filled, ░ empty) for an integer percentage.
make_bar() {
  local pct="$1" width=10 filled empty bar="" fill pad
  filled=$((pct * width / 100))
  empty=$((width - filled))
  if [ "$filled" -gt 0 ]; then printf -v fill "%${filled}s"; bar="${fill// /▓}"; fi
  if [ "$empty" -gt 0 ];  then printf -v pad  "%${empty}s";  bar="${bar}${pad// /░}"; fi
  printf "%s" "$bar"
}

# --- Vim mode badge ---
VIM_BADGE=""
if [ -n "$VIM_MODE" ]; then
  case "$VIM_MODE" in
    insert)  VIM_BADGE="\033[38;2;160;160;175m${VIM_INSERT_BG}  I ${R} " ;;
    normal)  VIM_BADGE="\033[38;2;150;170;200m${VIM_NORMAL_BG}  N ${R} " ;;
    visual)  VIM_BADGE="\033[38;2;175;155;185m${VIM_VISUAL_BG} 󰒅 V ${R} " ;;
    *)       VIM_BADGE="\033[38;2;160;160;175m${VIM_INSERT_BG}  ${VIM_MODE:0:1} ${R} " ;;
  esac
fi

# --- Context: count / max / % (both modes) ---
if [ -n "$PCT" ]; then
  PCT_INT=$(printf '%.0f' "$PCT")
  CTX_COLOR=$(usage_color "$PCT_INT")
  CTX="${SLATE}$(fmt_tokens "$USED_TOKENS")/$(fmt_tokens "$MAX_TOKENS")${R} ${CTX_COLOR}${PCT_INT}%${R}"
else
  CTX="${SLATE}--/-- --%${R}"
fi

# --- Plan extras: 5h session bar + 7d window % ---
PLAN=""
if [ "$MODE" = "plan" ]; then
  if [ -n "$FIVE_H" ]; then
    FH_INT=$(printf '%.0f' "$FIVE_H")
    FH_COLOR=$(usage_color "$FH_INT")
    SESSION="${SLATE}5h${R} ${FH_COLOR}$(make_bar "$FH_INT") ${FH_INT}%${R}"
  else
    SESSION="${SLATE}5h $(make_bar 0) --%${R}"
  fi

  if [ -n "$SEVEN_D" ]; then
    SD_INT=$(printf '%.0f' "$SEVEN_D")
    SD_COLOR=$(usage_color "$SD_INT")
    WINDOW="${SLATE}7d${R} ${SD_COLOR}${SD_INT}%${R}"
  else
    WINDOW="${SLATE}7d --%${R}"
  fi

  PLAN=" ${SEP} ${SESSION} ${SEP} ${WINDOW}"
fi

echo -e "${VIM_BADGE}${SKY} ${DIR}${R} ${SEP} ${LAVENDER}󰳗 ${MODEL}${R} ${SEP} ${CTX}${PLAN}${R}"
